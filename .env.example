# Empty values use offline-safe defaults. Never place real keys in this file.
OPENAI_API_KEY=
AVALAI_API_KEY=
# Set true only when local file keys should override inherited API key variables.
TUTOR_KEYS_FROM_DOTENV=false
TUTOR_PROVIDER=
TUTOR_MODEL=
TUTOR_MODEL_BASE_URL=
TUTOR_MODE=
TUTOR_LANGUAGE=
TUTOR_LEVEL=
TUTOR_DELIVERY=
TUTOR_SOURCES_DIR=
TUTOR_SEARCH_ENABLED=
TUTOR_SEARCH_BACKEND=tavily
TUTOR_SEARCH_URL=
TUTOR_SEARCH_API_KEY=
TUTOR_GENERATED_EXAMPLES_ENABLED=
TUTOR_MAX_INPUT_CHARS=
TUTOR_MAX_EXPRESSION_NODES=
TUTOR_MAX_EXPRESSION_DEPTH=
TUTOR_MAX_MATRIX_DIMENSION=
TUTOR_MATH_TIMEOUT_SECONDS=
TUTOR_REQUEST_TIMEOUT_SECONDS=
TUTOR_MAX_EVIDENCE_RECORDS=
TUTOR_MAX_EVIDENCE_CHARS=
TUTOR_MAX_HISTORY_MESSAGES=
TUTOR_MAX_CLARIFICATIONS=
TUTOR_MALFORMED_OUTPUT_REPAIRS=
TUTOR_WRITER_REPAIRS=
TUTOR_MAX_NUMBER_DIGITS=
TUTOR_MAX_POWER_MAGNITUDE=
TUTOR_MAX_OUTPUT_CHARS=
TUTOR_SEMANTIC_ENABLED=
# Set avalai to use AVALAI_API_KEY; defaults to text-embedding-3-large / 3072.
TUTOR_EMBEDDING_BACKEND=
TUTOR_EMBEDDING_BASE_URL=
# Optional separate key; AvalAI embeddings otherwise use AVALAI_API_KEY.
TUTOR_EMBEDDING_API_KEY=
TUTOR_EMBEDDING_MODEL=
# AvalAI: provider-managed; local: the pinned model revision.
TUTOR_EMBEDDING_REVISION=
TUTOR_EMBEDDING_DIMENSION=
TUTOR_EMBEDDING_MAX_TOKENS=
TUTOR_EMBEDDING_CACHE_DIR=
TUTOR_EMBEDDING_MODEL_DIR=
