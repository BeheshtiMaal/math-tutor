        },
        "domain": {
          "default": "real",
          "enum": [
            "real",
            "complex"
          ],
          "title": "Domain",
          "type": "string"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Assumptions",
          "type": "array"
        },
        "operation": {
          "const": "limit",
          "title": "Operation",
          "type": "string"
        },
        "point": {
          "$ref": "#/$defs/Expression"
