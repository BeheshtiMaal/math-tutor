          "$ref": "#/$defs/Expression"
        },
        "rhs": {
          "$ref": "#/$defs/Expression"
        },
        "variable": {
          "default": "x",
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$",
          "title": "Variable",
          "type": "string"
        },
        "domain": {
          "default": "real",
          "enum": [
            "real",
            "complex"
          ],
          "title": "Domain",
          "type": "string"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Assumptions",
          "type": "array"
        }
      },
      "required": [
        "operation",
        "lhs",
        "rhs"
      ],
      "title": "SolveProblem",
      "type": "object"
