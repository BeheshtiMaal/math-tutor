    "MatrixProblem": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "matrix",
          "title": "Operation",
          "type": "string"
        },
        "action": {
          "enum": [
            "determinant",
            "inverse",
            "rank",
            "transpose",
            "multiply"
          ],
          "title": "Action",
          "type": "string"
        },
        "matrix": {
          "items": {
            "items": {
              "$ref": "#/$defs/Expression"
            },
            "type": "array"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Matrix",
          "type": "array"
        },
        "other": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "$ref": "#/$defs/Expression"
                },
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Other"
        }
      },
      "required": [
        "operation",
        "action",
        "matrix"
      ],
      "title": "MatrixProblem",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "source_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
