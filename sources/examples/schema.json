{
  "$defs": {
    "DifferentiateProblem": {
      "additionalProperties": false,
      "properties": {
        "expression": {
          "$ref": "#/$defs/Expression"
        },
        "variable": {
          "default": "x",
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$",
          "title": "Variable",
          "type": "string"
        },
        "domain": {
          "default": "real",
          "enum": [
            "real",
            "complex"
          ],
          "title": "Domain",
          "type": "string"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Assumptions",
          "type": "array"
        },
        "operation": {
          "const": "differentiate",
          "title": "Operation",
          "type": "string"
        },
        "order": {
          "default": 1,
          "maximum": 10,
          "minimum": 1,
          "title": "Order",
          "type": "integer"
        }
      },
      "required": [
        "expression",
        "operation"
      ],
      "title": "DifferentiateProblem",
      "type": "object"
    },
    "Expression": {
      "additionalProperties": false,
      "description": "Allowlisted expression AST, not executable Python or a SymPy input string.",
      "properties": {
        "op": {
          "enum": [
            "number",
            "symbol",
            "constant",
            "add",
            "sub",
            "mul",
            "div",
            "pow",
            "neg",
            "sin",
            "cos",
            "tan",
            "exp",
            "log",
            "sqrt",
            "abs"
          ],
          "title": "Op",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "args": {
          "items": {
            "$ref": "#/$defs/Expression"
          },
          "maxItems": 256,
          "title": "Args",
          "type": "array"
        }
      },
      "required": [
        "op"
      ],
      "title": "Expression",
      "type": "object"
    },
    "IntegrateProblem": {
      "additionalProperties": false,
      "properties": {
        "expression": {
          "$ref": "#/$defs/Expression"
