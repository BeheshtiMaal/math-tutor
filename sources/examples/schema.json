        "original"
      ],
      "title": "Origin",
      "type": "string"
    },
    "operation_payload": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "differentiate": "#/$defs/DifferentiateProblem",
              "integrate": "#/$defs/IntegrateProblem",
              "limit": "#/$defs/LimitProblem",
              "matrix": "#/$defs/MatrixProblem",
              "simplify": "#/$defs/SimplifyProblem",
              "solve": "#/$defs/SolveProblem"
            },
            "propertyName": "operation"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/DifferentiateProblem"
            },
            {
              "$ref": "#/$defs/IntegrateProblem"
            },
            {
              "$ref": "#/$defs/LimitProblem"
            },
            {
              "$ref": "#/$defs/SolveProblem"
            },
            {
              "$ref": "#/$defs/MatrixProblem"
            },
            {
              "$ref": "#/$defs/SimplifyProblem"
            }
          ]
        },
