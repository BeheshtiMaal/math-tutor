        "section_title": {
          "minLength": 1,
          "title": "Section Title",
          "type": "string"
        },
        "source_author": {
          "minLength": 1,
          "title": "Source Author",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "usage_terms_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Usage Terms Url",
          "type": "string"
        },
        "usage_terms": {
          "minLength": 1,
          "title": "Usage Terms",
          "type": "string"
        }
      },
      "required": [
        "source_url",
        "section_title",
        "source_author",
        "retrieved_at",
        "usage_terms_url",
        "usage_terms"
