        "variable": {
          "default": "x",
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$",
          "title": "Variable",
          "type": "string"
        },
        "domain": {
          "default": "real",
          "enum": [
            "real",
            "complex"
          ],
          "title": "Domain",
          "type": "string"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Assumptions",
          "type": "array"
        },
        "operation": {
          "const": "integrate",
          "title": "Operation",
          "type": "string"
        },
        "lower": {
          "anyOf": [
            {
              "$ref": "#/$defs/Expression"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "upper": {
          "anyOf": [
            {
              "$ref": "#/$defs/Expression"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "expression",
        "operation"
      ],
      "title": "IntegrateProblem",
      "type": "object"
    },
    "LimitProblem": {
      "additionalProperties": false,
      "properties": {
